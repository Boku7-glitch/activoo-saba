# ─────────────────────────────────────────────────────────────
# activoo — environment variables
# Copy this file to `.env` for local development OR add the same
# variables in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public (exposed to the browser)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side (NEVER prefix with VITE_)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."   # secret — required for admin operations
